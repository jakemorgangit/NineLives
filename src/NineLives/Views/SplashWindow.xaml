<Window x:Class="Blackcat.NineLives.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nine Lives"
        Width="440" Height="470"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">

    <!-- Rounded card so the borderless window does not show hard corners against
         whatever is behind it. -->
    <Border CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#2D3148">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                <GradientStop Offset="0" Color="#0B0E17" />
                <GradientStop Offset="1" Color="#05070C" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="0,44,0,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0"
                            Template="{StaticResource NineLivesLogo}"
                            Height="200"
                            HorizontalAlignment="Center" />

            <TextBlock Grid.Row="1"
                       Style="{StaticResource LogoWordmark}"
                       Margin="0,28,0,0">
                <!-- Tracking is applied per-Run: WPF has no letter-spacing property, and a
                     wide-tracked wordmark is the distinguishing feature of the mark. -->
                <Run Text="N I N E" Foreground="#F2F4F8" />
                <Run Text="  " />
                <Run Text="L I V E S" Foreground="#3B83E9" />
            </TextBlock>

            <TextBlock Grid.Row="2"
                       Text="Every database deserves nine lives."
                       FontFamily="Segoe UI"
                       FontSize="13"
                       Foreground="#8890A4"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0" />

            <TextBlock Grid.Row="3"
                       Text="Blackcat Data Solutions"
                       FontFamily="Segoe UI"
                       FontSize="10.5"
                       Foreground="#4A5163"
                       HorizontalAlignment="Center"
                       Margin="0,22,0,0" />
        </Grid>
    </Border>
</Window>
